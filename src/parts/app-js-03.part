function customerPage(){const c=customers[state.selectedCustomer];return `${pageTitle('FACILITYDNA','Customers, facilities and spaces','One shared record connects every quote, project, delivery, document and relationship.',button(`${icons.plus} New customer`,'primary'))}<div class="split-layout"><section class="panel customer-list-panel"><div class="list-search">${icons.search}<input placeholder="Search customers…"></div>${customers.map((x,i)=>`<button class="customer-list-item ${i===state.selectedCustomer?'selected':''}" data-customer="${i}"><div class="customer-monogram">${x.name.split(' ').slice(0,2).map(y=>y[0]).join('')}</div><div><strong>${x.name}</strong><span>${x.facilities.length} facilities · Rep: ${x.rep}</span></div><b>${icons.chevron}</b></button>`).join('')}</section><section class="record-view"><div class="record-hero"><div class="record-badge">${icons.building}</div><div><span>${c.id}</span><h2>${c.name}</h2><p>${icons.pin} ${c.address}</p></div><div class="record-actions">${button('Edit profile')}${button('Start work','primary')}</div></div><div class="record-stats"><div><small>Relationship</small><strong>${c.tier}</strong></div><div><small>Status</small><strong>${c.health}</strong></div><div><small>Sales representative</small><strong>${c.rep}</strong></div><div><small>Open work</small><strong>6 records</strong></div></div><div class="record-tabs"><button class="active">Facilities</button><button>Activity</button><button>Documents</button><button>Contacts</button><button>Financial</button></div><div class="facility-stack">${c.facilities.map(f=>`<div class="facility-card"><div class="facility-top"><div class="facility-icon">${icons.building}</div><div><span>${f[1]}</span><h3>${f[0]}</h3></div><button class="icon-btn">${icons.chevron}</button></div><div class="spaces"><span>SPACES</span>${f[2].map(s=>`<button>${icons.pin} ${s}<b>${icons.chevron}</b></button>`).join('')}</div></div>`).join('')}</div></section></div>`}
function tasksPage(){return `${pageTitle('SHARED TASK ENGINE','Tasks','Every module routes assignments, approvals and follow-ups into one accountable queue.',button(`${icons.plus} New task`,'primary'))}<section class="panel table-panel"><div class="toolbar"><div class="segmented"><button class="active">My tasks</button><button>Team</button><button>All</button></div><div class="toolbar-right">${button('Due date')}${button('Status')}</div></div><div class="task-table"><div class="table-head"><span>Task</span><span>Owner</span><span>Priority</span><span>Status</span><span></span></div>${tasks.map((t,i)=>`<div class="table-row"><div class="task-name"><button data-complete="${i}" class="${t[4]==='Complete'?'checked':''}">${icons.check}</button><div><strong>${t[0]}</strong><small>${t[1]}</small></div></div><span>${t[2]}</span><span><i class="priority-dot ${t[3].toLowerCase()}"></i>${t[3]}</span><span><b class="pill ${statusClass(t[4])}">${t[4]}</b></span><button class="icon-btn">${icons.chevron}</button></div>`).join('')}</div></section>`}
function documentsPage(){const docs=[['Saranac Signed Subcontract.pdf','Contract','Saranac Community Schools','Today, 1:18 PM'],['Morrice Delivery Photos.zip','Delivery','Morrice Area Schools','Today, 11:42 AM'],['Mt Morris Court Proof v4.pdf','Design','Mt. Morris Schools','Yesterday'],['FCC Master W-9 2026.pdf','Company','Floor Care Concepts','Jul 29']];return `${pageTitle('SHARED DOCUMENT VAULT','Documents','Files stay connected to the customer, facility, project and workflow that created them.',button(`${icons.plus} Upload`,'primary'))}<section class="panel table-panel"><div class="toolbar"><div class="list-search wide">${icons.search}<input placeholder="Search all documents…"></div><div class="toolbar-right">${button('Document type')}${button('Owner')}</div></div><div class="document-grid">${docs.map(d=>`<button class="document-row"><div class="file-icon">${icons.file}</div><div><strong>${d[0]}</strong><span>${d[1]}</span></div><div><small>CONNECTED TO</small><strong>${d[2]}</strong></div><div><small>UPDATED</small><strong>${d[3]}</strong></div><b>${icons.chevron}</b></button>`).join('')}</div></section>`}
function operationsPage(){return `${pageTitle('OPERATIONS','Projects and fulfillment','A connected view from approved work through purchasing, staging, delivery and completion.',button(`${icons.plus} New project`,'primary'))}<section class="lane-board">${[['Ready to Order',5],['Vendor Confirmed',8],['Receiving',4],['Ready to Deliver',3]].map((x,idx)=>`<div class="lane"><div class="lane-head"><span>${x[0]}</span><b>${x[1]}</b></div>${['Saranac Jr/Sr High','Morrice Elementary','Mt. Morris High'].map((n,i)=>`<div class="work-card"><span>${n}</span><strong>${['Floor finish and supplies','Gym delivery order','Court refinishing project'][i]}</strong><small>ORD-${2400+idx*10+i} · Caleb</small><div class="work-card-foot"><span>${icons.clock} Due ${i+5} Aug</span><b>${icons.chevron}</b></div></div>`).join('')}</div>`).join('')}</section>`}
