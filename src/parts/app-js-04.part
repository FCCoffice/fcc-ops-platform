function salesPage(){return `${pageTitle('REVENUE','Sales and quoting','Capture the need once, build with the master price book, review and convert without re-entry.',button(`${icons.plus} New quote request`,'primary'))}<section class="panel"><div class="pipeline">${[['NEW REQUESTS','9','$184K potential'],['BUILDING','6','$126K potential'],['REP REVIEW','4','$92K potential'],['CUSTOMER REVIEW','7','$311K potential'],['APPROVED','3','$148K won']].map((x,i)=>`${i?`<b>${icons.chevron}</b>`:''}<div><small>${x[0]}</small><strong>${x[1]}</strong><span>${x[2]}</span></div>`).join('')}</div></section>`}
function financePage(){return `${pageTitle('FINANCE & ADMINISTRATION','Contracts and financial workflows','ContractOps, expenses and billing share the same customers, documents, approvals and audit trail.',button(`${icons.plus} New record`,'primary'))}<div class="dashboard-grid three">${[['PAY APPS','7','$482,600 submitted','check'],['WAIVERS','4','2 waiting on signature','file'],['EXPENSES','18','$12,940 unreconciled','sales']].map(x=>metric(x)).join('')}</div><section class="panel"><div class="panel-head"><div><span>REVIEW QUEUE</span><h3>Financial approvals</h3></div></div>${['Saranac Pay App #2 · $84,220','Mt. Morris Change Order #3 · $12,400','Company Card Report · Caleb · $1,284'].map((x,i)=>`<div class="approval-row"><div class="approval-number">0${i+1}</div><div><strong>${x}</strong><span>${['Controller review','Authorized signature','Receipt validation'][i]}</span></div>${button('Review')}</div>`).join('')}</section>`}
function reportsPage(){return `${pageTitle('SCORECENTER','Performance intelligence','Operational reporting across revenue, delivery, contracts, labor and customer performance.',button('Export report'))}<div class="dashboard-grid three">${[['ON-TIME WORK','94%','+3.2% this month','reports'],['PIPELINE','$1.84M','42 active opportunities','sales'],['UTILIZATION','86%','Across field crews','users']].map(x=>metric(x)).join('')}</div><section class="panel report-visual"><div class="panel-head"><div><span>30-DAY OPERATING TREND</span><h3>Work completed by week</h3></div></div><div class="bar-chart">${[42,68,56,88,76,94,83,100].map((h,i)=>`<div><span style="height:${h}%"></span><small>W${i+1}</small></div>`).join('')}</div></section>`}
function metric(x){return `<section class="panel metric-panel"><div class="signal-icon">${icons[x[3]]}</div><span>${x[0]}</span><strong>${x[1]}</strong><small>${x[2]}</small></section>`}
function workflowPage(){return `${pageTitle('SHARED WORKFLOW ENGINE','Workflow Center','Standard stages, owners, service levels and notifications power every FCC Ops process.',button(`${icons.plus} New workflow`,'primary'))}<div class="workflow-list">${workflows.map(w=>`<section class="panel workflow-detail"><div class="workflow-detail-head"><div><span>${w[3]} ACTIVE RECORDS</span><h3>${w[0]}</h3></div>${button('Configure')}</div><div class="stage-track">${w[1].map((s,i)=>`<div class="${i<w[2]?'complete':i===w[2]?'current':''}"><i>${i<w[2]?icons.check:i+1}</i><strong>${s}</strong><small>${[3,6,4,2,1][i]} records</small></div>`).join('')}</div></section>`).join('')}</div>`}
function launcher(){return `<div class="overlay" id="overlay"><div class="launcher"><div class="launcher-head"><div><small>FCC OPS</small><h2>Module launcher</h2><p>Open specialized tools without cluttering your everyday navigation.</p></div><button class="icon-btn" id="closeLauncher">${icons.close}</button></div><div class="module-grid">${modules.map(m=>`<button class="module-tile"><div class="module-icon">${icons[m[3]]}</div><div><small>${m[2]}</small><strong>${m[0]}</strong><p>${m[1]}</p></div><b>${icons.chevron}</b></button>`).join('')}</div></div></div>`}
