    <div class="topbar-center"><button class="global-search" id="searchBtn"><span>${icons.search}</span><span>Search customers, facilities, projects, documents…</span><kbd>⌘ K</kbd></button></div>
    <div class="top-actions"><button class="icon-btn grid-button" id="launcherBtn">${icons.grid}</button><button class="icon-btn notification-button" id="noticeBtn">${icons.bell}<i>4</i></button><div class="role-select-wrap"><span>${icons.shield}</span><select id="roleSelect">${Object.keys(roles).map(r=>`<option ${r===state.role?'selected':''}>${r}</option>`).join('')}</select></div><div class="avatar">BN</div></div>
  </header>
  <aside class="sidebar ${state.sidebar?'open':'closed'}"><div class="workspace-label"><span class="live-dot"></span><div><small>Workspace</small><strong>Floor Care Concepts</strong></div></div><nav>${nav}</nav><div class="sidebar-foot"><button><span>${icons.settings}</span><span>Platform settings</span></button><div class="user-card"><div class="avatar small">BN</div><div><strong>Blaine Naessens</strong><small>${state.role}</small></div><span>↪</span></div></div></aside>
  <main class="main ${state.sidebar?'with-sidebar':''}">${renderPage()}</main>
  ${state.launcher?launcher():''}${state.search?searchPalette():''}${state.notifications?notices():''}`;
  bind();
}

function renderPage(){return ({home:homePage,customers:customerPage,tasks:tasksPage,documents:documentsPage,operations:operationsPage,sales:salesPage,finance:financePage,reports:reportsPage,workflows:workflowPage}[state.active]||homePage)()}
function homePage(){
 const headline={Executive:'Command the business from one place.',Operations:'Keep today’s work moving.',Sales:'Move customers and quotes forward.',Accounting:'Protect cash flow and close the loop.',Warehouse:'Stage, load and deliver with confidence.'}[state.role];
 const open=tasks.filter(t=>t[4]!=='Complete').slice(0,4);
 return `${pageTitle(`MY WORK · ${state.role.toUpperCase()}`,headline,'Your priorities, approvals, activity and operating signals—assembled from every FCC Ops module.',button(`${icons.calendar} Today`)+button(`${icons.plus} Create`,'primary'))}
 <section class="hero-band"><div><span class="hero-kicker">TUESDAY · AUGUST 4</span><h2>Good afternoon, Blaine.</h2><p>There are <strong>3 items requiring attention</strong> before today’s work is fully on track.</p></div><div class="hero-score"><small>OPERATIONS PULSE</small><strong>92</strong><span>Game ready</span></div></section>
 <section class="signal-row">${[['Approvals waiting','3','2 due today','check'],['Open tasks','8','5 assigned to you','tasks'],['Active projects','27','6 moving today','finance'],['Deliveries','4','2 ready to load','truck']].map(x=>`<button class="signal"><div class="signal-icon">${icons[x[3]]}</div><div><small>${x[0]}</small><strong>${x[1]}</strong><span>${x[2]}</span></div><b>${icons.chevron}</b></button>`).join('')}</section>
 <div class="dashboard-grid"><section class="panel priorities"><div class="panel-head"><div><span>YOUR QUEUE</span><h3>Priorities</h3></div><button class="text-button" data-nav="tasks">View all</button></div>${open.map((t,i)=>`<div class="task-row"><button class="task-check" data-complete="${tasks.indexOf(t)}">${icons.check}</button><div class="task-copy"><strong>${t[0]}</strong><span>${t[1]}</span></div><div class="pill ${statusClass(t[4])}">${t[4]}</div><b>${icons.chevron}</b></div>`).join('')}</section>
 <section class="panel"><div class="panel-head"><div><span>COMPANY FEED</span><h3>Live activity</h3></div><button class="icon-btn">${icons.activity}</button></div><div class="timeline">${[['Delivery ticket completed','Morrice Elementary · Received by K. Riley','18 min ago','check'],['Document added','Saranac · Signed subcontract uploaded','42 min ago','file'],['Workflow advanced','Mt. Morris quote moved to Customer Review','1 hr ago','workflow'],['Crew updated','Thursday sanding crew reassigned','2 hrs ago','users']].map(a=>`<div class="timeline-item"><div class="timeline-icon">${icons[a[3]]}</div><div><strong>${a[0]}</strong><p>${a[1]}</p><small>${a[2]}</small></div></div>`).join('')}</div></section></div>
 <section class="panel workflow-strip"><div class="panel-head"><div><span>WORKFLOW WATCH</span><h3>Where work is collecting</h3></div><button class="text-button" data-nav="workflows">Open Workflow Center</button></div><div class="workflow-cards">${workflows.slice(0,3).map(w=>`<div class="mini-workflow"><div><strong>${w[0]}</strong><span>${w[3]} active records</span></div><div class="mini-stage">${w[1].map((_,i)=>`<i class="${i<=w[2]?'done':''}"></i>`).join('')}</div><small>${w[1][w[2]]} is the busiest stage</small></div>`).join('')}</div></section>`;
}
