function pageTitle(eyebrow,title,copy,actions=''){return `<div class="page-title"><div><span>${eyebrow}</span><h1>${title}</h1><p>${copy}</p></div><div class="page-actions">${actions}</div></div>`}
function button(label,kind='secondary',action=''){return `<button class="${kind}" ${action}>${label}</button>`}
function statusClass(s){return s.toLowerCase().replaceAll(' ','-')}

function shell(){
  const allowed=roles[state.role];
  const nav=navGroups.map(([g,items])=>{const visible=items.filter(x=>allowed.includes(x[0]));if(!visible.length)return'';return `<div class="nav-group"><div class="nav-label">${g}</div>${visible.map(([id,label,ic])=>`<button data-nav="${id}" class="${state.active===id?'active':''}"><span class="nav-icon">${icons[ic]}</span><span>${label}</span>${id==='tasks'?'<em>8</em>':''}</button>`).join('')}</div>`}).join('');
  document.getElementById('app').innerHTML=`
  <header class="topbar">
    <div class="brand-zone"><button class="icon-btn" id="menuBtn">${icons.menu}</button><div class="brand-mark"><span>FCC</span></div><div class="brand-copy"><strong>FCC Ops</strong><small>The Sports Floor Pros</small></div></div>
